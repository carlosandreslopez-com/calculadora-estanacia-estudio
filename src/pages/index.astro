---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AdvisorCta from '../components/AdvisorCta.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { Calculator } from '../components/Calculator.tsx';
---

<Layout>
  <div class="min-h-screen px-4 pt-5 pb-14 sm:px-6 sm:pt-8 sm:pb-[72px]">
    <div class="mx-auto w-full max-w-[880px]">
      <!-- Utility bar -->
      <div class="no-print mb-6">
        <span
          class="inline-flex items-center gap-2 px-[13px] py-1.5 border border-[#d8d4c8] rounded-full bg-surface-sunken text-[11.5px] font-semibold tracking-[0.06em] uppercase text-[#5f6776]"
        >
          <span class="w-[7px] h-[7px] rounded-full bg-success inline-block" aria-hidden="true"></span>
          Herramienta orientativa · España
        </span>
      </div>

      <Header />

      <main>
        <Calculator client:only="react">
          <div
            slot="fallback"
            class="bg-surface border border-border rounded-card shadow-card p-6 sm:p-7"
          >
            <div class="flex items-center justify-center gap-3 py-16 text-muted-2">
              <svg
                class="h-5 w-5 animate-spin text-primary"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span class="text-sm">Cargando calculadora…</span>
            </div>
          </div>
        </Calculator>
      </main>

      <AdvisorCta />
      <Disclaimer />
    </div>
  </div>
</Layout>
