---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { Calculator } from '../components/Calculator.tsx';
---

<Layout>
  <div class="bg-slate-900 text-slate-200 min-h-screen font-sans flex flex-col items-center p-4 sm:p-6 lg:p-8">
    <div class="w-full max-w-7xl mx-auto">
      <Header />
      <main class="mt-8 bg-slate-800/50 rounded-xl p-4 sm:p-8 border border-slate-700 shadow-2xl shadow-slate-950/50">
        <Calculator client:only="react">
          <div slot="fallback" class="flex items-center justify-center gap-3 py-20 text-slate-400">
            <svg class="h-5 w-5 animate-spin text-sky-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="text-sm">Cargando calculadora…</span>
          </div>
        </Calculator>
      </main>
      <Disclaimer />
    </div>
  </div>
</Layout>
